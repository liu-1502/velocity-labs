# Canonical origin — used for metadataBase, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://velocity-labs.tech

# Public contact address rendered in the Contact section + footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@velocity-labs.tech

# Optional: origin to pull the original media from when running `npm run assets:fetch`.
ASSET_SOURCE_ORIGIN=https://velocity-labs-revamp.vercel.app
