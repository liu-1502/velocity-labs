{
  "name": "velocity-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Velocity Labs — marketing site. Next.js 15 (App Router) + TypeScript + Tailwind v4 + Framer Motion.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "posters:make": "node scripts/make-posters.mjs",
    "assets:all": "npm run assets:fetch && npm run posters:make"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lenis": "^1.3.26",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.26.0",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.5",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3"
  }
}
